  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "seed": {
      "$ref": "#/definitions/hex",
      "description": "The colour Elbert's palette is generated from. Setting it takes the accent and wallpaper colours from the user."
    },
    "colors": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "light": {
          "description": "Colour roles to override in light mode.",
          "$ref": "#/definitions/colorSet"
        },
        "dark": {
          "description": "Colour roles to override in dark mode.",
          "$ref": "#/definitions/colorSet"
        },
        "amoled": {
          "description": "Applied on top of dark after Elbert makes the surfaces true black.",
          "$ref": "#/definitions/colorSet"
        }
      }
    },
    "typography": {
      "type": "object",
      "properties": {
        "fontFamily": {
          "type": "string",
          "description": "A Google Fonts family."
        },
        "font": {
          "type": "object",
          "description": "A font the theme ships. Wins over fontFamily.",
          "required": [
            "family",
            "files"
          ],
          "properties": {
            "family": {
              "type": "string"
            },
            "files": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "pattern": "\\.(ttf|otf)$"
              },
              "description": ".ttf or .otf files inside the package."
            }
          }
        },
        "scale": {
          "type": "number",
          "minimum": 0.85,
          "maximum": 1.25,
          "description": "Multiplies every text size."
        }
      }
    },
    "shapes": {
      "type": "object",
      "properties": {
        "scale": {
          "type": "number",
          "minimum": 0,
          "maximum": 2,
          "description": "Multiplies every corner in the app. 0 is square, 1 is Elbert's own."
        },
        "radii": {
          "type": "object",
          "description": "Pins named corners to an exact radius; these ignore scale.",
          "additionalProperties": false,
          "properties": {
            "extraSmall": {
              "type": "number",
              "minimum": 0,
              "maximum": 200
            },
            "small": {
              "type": "number",
              "minimum": 0,
              "maximum": 200
            },
            "medium": {
              "type": "number",
              "minimum": 0,
              "maximum": 200
            },
            "large": {
              "type": "number",
              "minimum": 0,
              "maximum": 200
            },
            "largeIncreased": {
              "type": "number",
              "minimum": 0,
              "maximum": 200
            },
            "extraLarge": {
              "type": "number",
              "minimum": 0,
              "maximum": 200
            },
            "extraLargeIncreased": {
              "type": "number",
              "minimum": 0,
              "maximum": 200
            }
          }
        },
        "buttons": {
          "enum": [
            "pill",
            "rounded",
            "square"
          ],
          "description": "Resting shape of buttons, chips and the navigation indicator."
        }
      }
    },
    "components": {
      "type": "object",
      "description": "Per-component looks. Anything left out stays Elbert's own.",
      "additionalProperties": false,
      "properties": {
        "card": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "radius": {
              "type": "number",
              "minimum": 0,
              "maximum": 200,
              "description": "Corner radius in logical pixels."
            },
            "color": {
              "$ref": "#/definitions/colorRef",
              "description": "Background colour."
            },
            "borderColor": {
              "$ref": "#/definitions/colorRef",
              "description": "Border colour."
            },
            "borderWidth": {
              "type": "number",
              "minimum": 0,
              "maximum": 12,
              "description": "Border width. Without a colour the border is transparent."
            },
            "padding": {
              "description": "Inner padding.",
              "oneOf": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 200
                },
                {
                  "type": "array",
                  "items": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 200
                  },
                  "minItems": 2,
                  "maxItems": 2
                },
                {
                  "type": "array",
                  "items": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 200
                  },
                  "minItems": 4,
                  "maxItems": 4
                }
              ]
            }
          }
        },
        "songRow": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "radius": {
              "type": "number",
              "minimum": 0,
