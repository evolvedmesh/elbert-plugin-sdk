{
  "name": "@evolvedmesh/elbert-plugin-sdk",
  "version": "1.2.0",
  "description": "Types, build tooling and documentation for Elbert plugins.",
  "license": "MIT",
  "type": "module",
  "types": "types/elbert.d.ts",
  "exports": {
    ".": {
      "types": "./types/elbert.d.ts"
    },
    "./theme": {
      "types": "./types/theme.d.ts"
    }
  },
  "bin": {
    "elbert-plugin": "bin/elbert-plugin.ts"
  },
  "files": [
    "bin",
    "types",
    "schemas",
    "docs",
    "README.md"
  ],
  "engines": {
    "bun": ">=1.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/evolvedmesh/elbert-plugin-sdk.git"
  },
  "keywords": [
    "elbert",
    "plugin",
    "music"
  ],
  "scripts": {
    "typecheck": "tsc -p . && tsc -p examples/radio-browser",
    "lint": "biome check .",
    "format": "biome format --write .",
    "fix": "biome check --write .",
    "check": "bun run typecheck && bun run lint && bun scripts/gen-schemas.ts --check && bun run docs:check && bun run example:build && bun run theme:build",
    "example:build": "cd examples/radio-browser && bun ../../bin/elbert-plugin.ts build",
    "example:pack": "cd examples/radio-browser && bun ../../bin/elbert-plugin.ts pack --to ../../dist",
    "schemas": "bun scripts/gen-schemas.ts",
    "docs:check": "bun scripts/check-docs.ts",
    "theme:build": "cd examples/dusk-theme && bun ../../bin/elbert-plugin.ts build",
    "theme:pack": "cd examples/dusk-theme && bun ../../bin/elbert-plugin.ts pack --to ../../dist"
  },
  "dependencies": {
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^10.0.1",
    "@types/bun": "latest",
    "semantic-release": "^25.0.9",
    "typescript": "^7.0.2"
  }
}
