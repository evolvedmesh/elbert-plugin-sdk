// The backdrop behind every page. A theme's background is plain data: no
// code, no network. Colours are roles, so it follows light, dark and AMOLED.
import core;
import elbert;

widget Aurora = Stack(
  fit: "expand",
  children: [
    // A slow colour wash from the accent's container tones to the surface.
    GradientFill(
      kind: "linear",
      colors: ["surface", "primaryContainer", "surface"],
      stops: [0.0, 0.55, 1.0],
      angle: 0.08,
      spin: 240.0,
      opacity: 0.55,
    ),
    // Two glows that wander and breathe out of step with each other.
    Orb(color: "primary", opacity: 0.35, size: 0.9, x: -0.7, y: -0.6, driftX: 0.25, driftY: 0.2, seconds: 38.0),
    Orb(color: "tertiary", opacity: 0.22, size: 0.7, x: 0.8, y: 0.2, driftX: 0.2, driftY: 0.3, seconds: 52.0, phase: 0.4),
    Particles(count: 36, color: "onSurface", opacity: 0.35, size: 1.8, speed: 0.012),
    Waves(colors: ["primaryContainer", "secondaryContainer"], opacity: 0.25, baseline: 0.82, amplitude: 0.025, seconds: 22.0),
  ],
);
